rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'leekny12@gmail.com';
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(resourceData) {
      return isSignedIn() && (
        !('userId' in resourceData) || 
        resourceData.userId == request.auth.uid || 
        resourceData.get('userId', '') == '' ||
        resourceData.get('userId', '') == request.auth.uid
      );
    }

    // Products
    match /products/{productId} {
      allow read, update, delete: if isSuperAdmin() || isOwner(resource);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Orders
    match /orders/{orderId} {
      allow read, update, delete: if isSuperAdmin() || isOwner(resource);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Transactions (Ledger)
    match /transactions/{transactionId} {
      allow read, update, delete: if isSuperAdmin() || isOwner(resource);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Drafts (Saved bills)
    match /drafts/{draftId} {
      allow read, update, delete: if isSuperAdmin() || isOwner(resource);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Metadata (Summaries, settings)
    match /metadata/{docId} {
      allow read, write: if isSuperAdmin() || (isSignedIn() && docId == request.auth.uid);
    }
  }
}
